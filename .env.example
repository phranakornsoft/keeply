# Copy to .env next to docker-compose.yml, which passes these to the containers.

# Public origin of the app. Session cookies are Secure only when this starts with https://.
# Production: https://keeeply.ai  Staging: https://keeeply.test.phranakornsoft.com
APP_ORIGIN=https://keeeply.ai
# Host port the app container listens on (bound to 127.0.0.1 for the reverse proxy).
# Staging and production on one host need different ports and project names, e.g. docker compose -p keeply-staging up -d.
APP_PORT=3000

# LINE Login channel. Register ${APP_ORIGIN}/ as a callback URL in the LINE Developers console,
# one per environment: https://keeeply.ai/ and https://keeeply.test.phranakornsoft.com/
# Leave LINE_CHANNEL_ID empty to build the demo-mode UI. To try LINE from the Vite dev server, also set VITE_LINE_CHANNEL_ID.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Password for the keeply database user.
DB_PASSWORD=change-me
